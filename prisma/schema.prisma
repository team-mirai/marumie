generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  authId    String   @unique @map("auth_id")
  email     String   @unique @db.VarChar(255)
  role      UserRole @default(user)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantMemberships UserTenantMembership[]

  researchFundJournalEntriesCreated ResearchFundJournalEntry[]
  researchFundScanBatchesUploaded   ResearchFundScanBatch[]
  researchFundPromptsUpdated        ResearchFundPrompt[]

  @@map("users")
}

model Tenant {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  politicalOrganizations PoliticalOrganization[]
  counterparts           Counterpart[]
  donors                 Donor[]
  memberships            UserTenantMembership[]
  politicians            Politician[]

  @@map("tenants")
}

model UserTenantMembership {
  id        BigInt     @id @default(autoincrement())
  userId    String     @map("user_id")
  tenantId  BigInt     @map("tenant_id")
  role      TenantRole @default(editor)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenant_memberships")
}

model PoliticalOrganization {
  id               BigInt            @id @default(autoincrement())
  displayName      String            @map("display_name") @db.VarChar(255)
  description      String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  slug             String            @unique @db.VarChar(255)
  orgName          String?           @map("org_name") @db.VarChar(255)

  tenantId BigInt? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  balanceSnapshots BalanceSnapshot[]
  reportProfiles   OrganizationReportProfile[]
  transactions     Transaction[]
  politicianMemberships PoliticianOrgMembership[]

  @@index([tenantId])
  @@map("political_organizations")
}

model Transaction {
  id                       BigInt                   @id @default(autoincrement())
  politicalOrganizationId  BigInt                   @map("political_organization_id")
  transactionNo            String                   @map("transaction_no") @db.VarChar(255)
  transactionDate          DateTime                 @map("transaction_date") @db.Date
  financialYear            Int                      @map("financial_year")
  transactionType          TransactionType          @map("transaction_type")
  debitAccount             String                   @map("debit_account") @db.VarChar(255)
  debitSubAccount          String?                  @map("debit_sub_account") @db.VarChar(255)
  debitDepartment          String?                  @map("debit_department") @db.VarChar(255)
  debitPartner             String?                  @map("debit_partner") @db.VarChar(255)
  debitTaxCategory         String?                  @map("debit_tax_category") @db.VarChar(255)
  debitAmount              Decimal                  @map("debit_amount") @db.Decimal(15, 2)
  creditAccount            String                   @map("credit_account") @db.VarChar(255)
  creditSubAccount         String?                  @map("credit_sub_account") @db.VarChar(255)
  creditDepartment         String?                  @map("credit_department") @db.VarChar(255)
  creditPartner            String?                  @map("credit_partner") @db.VarChar(255)
  creditTaxCategory        String?                  @map("credit_tax_category") @db.VarChar(255)
  creditAmount             Decimal                  @map("credit_amount") @db.Decimal(15, 2)
  description              String?
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  memo                     String?
  friendlyCategory         String?                  @map("friendly_category")
  categoryKey              String                   @map("category_key") @db.VarChar(255)
  label                    String                   @default("") @db.VarChar(255)
  hash                     String                   @default("") @db.VarChar(255)
  isGrantExpenditure       Boolean                  @default(false) @map("is_grant_expenditure")
  politicalOrganization    PoliticalOrganization    @relation(fields: [politicalOrganizationId], references: [id], onDelete: Cascade)
  transactionCounterparts  TransactionCounterpart[]
  transactionDonors        TransactionDonor[]

  @@unique([politicalOrganizationId, financialYear, transactionNo])
  @@index([politicalOrganizationId, financialYear, transactionType, transactionDate(sort: Desc)])
  @@map("transactions")
}

model Counterpart {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(120)
  postalCode String?  @db.VarChar(10) @map("postal_code")
  address    String?  @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenantId BigInt? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  transactionCounterparts TransactionCounterpart[]

  // address が NULL の行も重複として扱うため、実 DB の一意インデックスは NULLS NOT DISTINCT（マイグレーションで張り替え。#1482）
  @@unique([name, address])
  @@index([tenantId])
  @@map("counterparts")
}

model TransactionCounterpart {
  id            BigInt      @id @default(autoincrement())
  transactionId BigInt      @map("transaction_id")
  counterpartId BigInt      @map("counterpart_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  counterpart Counterpart @relation(fields: [counterpartId], references: [id], onDelete: Cascade)

  @@unique([transactionId, counterpartId])
  @@unique([transactionId])
  @@index([transactionId], name: "idx_transaction_counterparts_transaction")
  @@index([counterpartId], name: "idx_transaction_counterparts_counterpart")
  @@map("transaction_counterparts")
}

model BalanceSnapshot {
  id                      BigInt                @id @default(autoincrement())
  politicalOrganizationId BigInt                @map("political_organization_id")
  snapshotDate            DateTime              @map("snapshot_date") @db.Date
  balance                 Decimal               @db.Decimal(15, 2)
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  politicalOrganization   PoliticalOrganization @relation(fields: [politicalOrganizationId], references: [id], onDelete: Cascade)

  @@index([politicalOrganizationId, snapshotDate(sort: Desc), updatedAt(sort: Desc)])
  @@map("balance_snapshots")
}

model Donor {
  id                BigInt            @id @default(autoincrement())
  donorType         DonorType         @map("donor_type")
  name              String            @db.VarChar(120)
  address           String?           @db.VarChar(120)
  occupation        String?           @db.VarChar(50)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tenantId BigInt? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  transactionDonors TransactionDonor[]

  // address が NULL の行も重複として扱うため、実 DB の一意インデックスは NULLS NOT DISTINCT（マイグレーションで張り替え。#1482）
  @@unique([name, address, donorType])
  @@index([tenantId])
  @@map("donors")
}

model TransactionDonor {
  id            BigInt      @id @default(autoincrement())
  transactionId BigInt      @map("transaction_id")
  donorId       BigInt      @map("donor_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  donor       Donor       @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([transactionId, donorId])
  @@unique([transactionId])
  @@index([transactionId], name: "idx_transaction_donors_transaction")
  @@index([donorId], name: "idx_transaction_donors_donor")
  @@map("transaction_donors")
}

model OrganizationReportProfile {
  id                      BigInt   @id @default(autoincrement())
  politicalOrganizationId BigInt   @map("political_organization_id")
  financialYear           Int      @map("financial_year")

  officialName            String?  @map("official_name") @db.VarChar(120)
  officialNameKana        String?  @map("official_name_kana") @db.VarChar(120)
  officeAddress           String?  @map("office_address") @db.VarChar(80)
  officeAddressBuilding   String?  @map("office_address_building") @db.VarChar(60)

  details                 Json     @default("{}")

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  politicalOrganization   PoliticalOrganization @relation(fields: [politicalOrganizationId], references: [id], onDelete: Cascade)

  @@unique([politicalOrganizationId, financialYear])
  @@map("organization_report_profiles")
}

// =====================================================================
// 調査研究費（調研費）
// 設計の正: docs/reference/design_handoff_choken/01_データモデル.md
// 既存 transactions（政治資金）とは完全に別系統。counterpart/donor の
// DB トリガーが transactions の category_key 語彙に依存しているため触らない。
// =====================================================================

// 議員。政党テーブルは新設せず、所属は PoliticianOrgMembership 経由で
// 既存 political_organizations を参照する（所属なしでも存在できる）。
// tenant_id は既存 political_organizations と同じく nullable（テナント強制は #1112）。
model Politician {
  id                   BigInt   @id @default(autoincrement())
  name                 String   @db.VarChar(255)
  slug                 String   @unique @db.VarChar(255)
  termStart            DateTime @map("term_start") @db.Date // 支給の起点（当選日）
  displayOrder         Int      @default(0) @map("display_order")
  // 調研費を公開するか。議員室ごとにプレビューしてから順次公開するため、新規・既存とも非公開から始める
  isResearchFundPublic Boolean  @default(false) @map("is_research_fund_public")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenantId BigInt? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  memberships PoliticianOrgMembership[]
  books       ResearchFundBook[]
  prompts     ResearchFundPrompt[]
  payees      ResearchFundPayee[]

  @@index([tenantId])
  @@map("politicians")
}

// 議員と政治団体（政党）の所属履歴。離党・移籍は ended_on で残す。
model PoliticianOrgMembership {
  id                      BigInt    @id @default(autoincrement())
  politicianId            BigInt    @map("politician_id")
  politicalOrganizationId BigInt    @map("political_organization_id")
  startedOn               DateTime  @map("started_on") @db.Date
  endedOn                 DateTime? @map("ended_on") @db.Date
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  politician            Politician            @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  politicalOrganization PoliticalOrganization @relation(fields: [politicalOrganizationId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([politicalOrganizationId])
  @@map("politician_org_memberships")
}

// 議員 × 年度 = 1年間のお財布
model ResearchFundBook {
  id               BigInt                 @id @default(autoincrement())
  politicianId     BigInt                 @map("politician_id")
  financialYear    Int                    @map("financial_year")
  status           ResearchFundBookStatus @default(preparing)
  publishedThrough DateTime?              @map("published_through") @db.Date // 何月分まで公開（例: 2026-08-31）
  asOfDate         DateTime?              @map("as_of_date") @db.Date // 「2026.8.20時点」
  nextUpdateNote   String?                @map("next_update_note") // 「次回更新 11月ごろ」
  policyComment    String?                @map("policy_comment") // 活用方針（議員本人が書く1〜2行）
  details          Json? // B-5「データについて」の説明文
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  journalEntries    ResearchFundJournalEntry[]
  documents         ResearchFundDocument[]
  scanBatches       ResearchFundScanBatch[]
  expenditureGroups ResearchFundExpenditureGroup[]

  @@unique([politicianId, financialYear])
  @@map("research_fund_books")
}

// 支払先（支出を受けた者）。議員課提出用の帳簿に氏名・住所を載せるために持つ。
// 政治資金の counterparts とは共用しない（調研費は transactions 系と完全に別系統で、
// counterparts は全テナント横断の一意制約と DB トリガーを持つため）。
// 住所は NULL を使わず未入力を空文字で表す。counterparts の自然キーが address NULL を
// 重複扱いせず、同じ取引先の行を何行でも作れてしまう問題（#1482）を繰り返さないため。
model ResearchFundPayee {
  id                        BigInt   @id @default(autoincrement())
  politicianId              BigInt   @map("politician_id")
  name                      String   @db.VarChar(255) // 氏名（団体にあってはその名称）
  postalCode                String?  @map("postal_code") @db.VarChar(10) // NULL = 未入力
  address                   String   @default("") @db.VarChar(255) // 住所（団体にあっては主たる事務所の所在地）。空文字 = 未入力
  invoiceRegistrationNumber String?  @map("invoice_registration_number") @db.VarChar(14) // "T" + 13桁。NULL = 未入力・インボイス未登録
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)

  journalEntries ResearchFundJournalEntry[]

  // 支払先は議員ごとに持つ（同じ店でも議員室ごとに別の行）
  @@unique([politicianId, name, address])
  @@map("research_fund_payees")
}

// 科目マスタ（固定）。シードは prisma/seeds/researchFundAccounts.ts
model ResearchFundAccount {
  key              String                  @id @db.VarChar(50) // "taxi" など
  label            String                  @db.VarChar(100) // "タクシー代"
  type             ResearchFundAccountType
  legalCategoryKey String?                 @map("legal_category_key") @db.VarChar(50) // 法定区分キー（expense のみ）
  legalLabel       String?                 @map("legal_label") @db.VarChar(100) // "③ 備品・消耗品費"
  displayOrder     Int                     @default(0) @map("display_order")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  journalLines ResearchFundJournalLine[]

  @@map("research_fund_accounts")
}

// 仕訳（複式）。借方合計 = 貸方合計 はドメイン層で検証する。
model ResearchFundJournalEntry {
  id          BigInt                  @id @default(autoincrement())
  bookId      BigInt                  @map("book_id")
  entryDate   DateTime                @map("entry_date") @db.Date
  description String                  @db.VarChar(255) // 公開用の項目名（店名でなく何に使ったか）
  status      ResearchFundEntryStatus @default(draft)
  source      ResearchFundEntrySource
  documentId  BigInt?                 @map("document_id") // 領収書。徴し難かった場合は NULL
  splitGroup  String?                 @map("split_group") @db.VarChar(255) // 同一注文の行分割キー
  note        String? // 特記事項（公開される）
  memo        String? // 備考（公開されない事務所内メモ）
  // 立替者（公開されない事務所内の管理情報）。NULL = 調研費口座から直接支出（立替なし）
  advancedBy  String?                 @map("advanced_by") @db.VarChar(255)
  // 立替の精算日。NULL = 未精算。立替者がいる仕訳だけが持てる（DB 側の CHECK 制約で保証）
  settledAt   DateTime?               @map("settled_at") @db.Date

  // 以下は議員課提出用の帳簿（衆議院・参議院フォーマット）の列のために持つ。
  // 支払先（支出を受けた者）。NULL = 未特定。帳簿と同じ議員の支払先であることはアプリ側で検証する
  // （紐づける各リポジトリが同じトランザクションで確かめる）。DB で保証するには仕訳に politician_id を
  // 非正規化して複合外部キーを張る必要があり、book の議員との二重管理になるため採らない（#1674）
  payeeId BigInt? @map("payee_id")
  // 支払先を誰が紐づけたか。支払先があるときは必ず持つ（DB 側の CHECK 制約で保証）
  payeeLinkSource ResearchFundPayeeLinkSource? @map("payee_link_source")
  // AI が紐づけたときの確信度（0.000〜1.000）と根拠。source = ai のときだけ持てる
  payeeLinkConfidence Decimal? @map("payee_link_confidence") @db.Decimal(4, 3)
  payeeLinkReason     String?  @map("payee_link_reason")
  // 領収書等を徴し難かった事情。領収書（document_id）が無い仕訳だけが持てる
  receiptAbsenceReason String? @map("receipt_absence_reason")
  // 資金管理団体からの支出
  fromFundManagementOrg Boolean @default(false) @map("from_fund_management_org")
  // 「1万円超として扱う」（参議院）の手動上書き。NULL = 金額からの自動判定に従う
  treatAsOverTenThousand Boolean? @map("treat_as_over_ten_thousand")

  publishedAt DateTime?               @map("published_at")
  createdById String?                 @map("created_by_id")
  hash        String                  @default("") @db.VarChar(255) // 再取込・二重登録の重複検知
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  book      ResearchFundBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  document  ResearchFundDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // 紐づけ先を消すときは先に紐づけを外す（誰が紐づけたかだけが残る状態を作らない）。
  // Restrict ではなく NoAction にするのは、議員の削除で支払先と仕訳が同時に消える
  // カスケードを止めないため（NoAction は文の終わりに検査する）
  payee     ResearchFundPayee?    @relation(fields: [payeeId], references: [id], onDelete: NoAction)

  lines      ResearchFundJournalLine[]
  groupItems ResearchFundGroupItem[]

  @@index([bookId, status, entryDate(sort: Desc)])
  @@unique([bookId, hash]) // 再取込・二重登録の重複検知を DB 側でも保証する
  @@index([documentId])
  // 支払先ごとの仕訳の絞り込み・支払先の削除可否の判定用
  @@index([payeeId])
  // 立替者ごとの未精算の集計・絞り込み用
  @@index([bookId, advancedBy, settledAt], map: "research_fund_journal_entries_advance_idx")
  @@map("research_fund_journal_entries")
}

model ResearchFundJournalLine {
  id         BigInt                  @id @default(autoincrement())
  entryId    BigInt                  @map("entry_id")
  side       ResearchFundJournalSide
  accountKey String                  @map("account_key") @db.VarChar(50)
  amount     Decimal                 @db.Decimal(12, 0) // 円・整数
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  entry   ResearchFundJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account ResearchFundAccount      @relation(fields: [accountKey], references: [key])

  @@index([entryId])
  @@index([accountKey])
  @@map("research_fund_journal_lines")
}

// 領収書などの書類。原本は Supabase Storage（非公開バケット）。
model ResearchFundDocument {
  id               BigInt   @id @default(autoincrement())
  bookId           BigInt   @map("book_id")
  batchId          BigInt?  @map("batch_id")
  storageKey       String   @map("storage_key") @db.VarChar(255) // 原本
  maskedKey        String?  @map("masked_key") @db.VarChar(255) // 公開用マスキング済み（当面は未使用＝原本公開）
  mime             String   @db.VarChar(100) // image/jpeg | image/png | application/pdf
  originalFilename String   @map("original_filename") @db.VarChar(255)
  // 領収書等番号（議員課提出用の帳簿の列）。帳簿の中で一意な通し番号。NULL = 未採番
  receiptNumber    Int?     @map("receipt_number")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  book  ResearchFundBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  batch ResearchFundScanBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  journalEntries ResearchFundJournalEntry[]
  scanJobs       ResearchFundScanJob[]

  // 領収書等番号は帳簿の中で一意（未採番の NULL は重複してよい）
  @@unique([bookId, receiptNumber])
  @@index([bookId])
  @@index([batchId])
  @@map("research_fund_documents")
}

model ResearchFundScanBatch {
  id           BigInt   @id @default(autoincrement())
  bookId       BigInt   @map("book_id")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  book       ResearchFundBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  uploadedBy User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  documents ResearchFundDocument[]
  jobs      ResearchFundScanJob[]

  @@index([bookId])
  @@map("research_fund_scan_batches")
}

// 1書類 = 1ジョブ
model ResearchFundScanJob {
  id                BigInt                    @id @default(autoincrement())
  batchId           BigInt                    @map("batch_id")
  documentId        BigInt                    @map("document_id")
  status            ResearchFundScanJobStatus @default(queued)
  promptId          BigInt                    @map("prompt_id") // 使った版を記録
  model             String                    @db.VarChar(100) // "claude-opus-4-1" など
  rawJson           Json?                     @map("raw_json") // LLM の構造化出力の原文（監査用）
  rereadInstruction String?                   @map("reread_instruction") // 読み直し時のフリーテキスト指示（通常スキャンでは null。監査用に残す）
  error             String?
  startedAt         DateTime?                 @map("started_at")
  finishedAt        DateTime?                 @map("finished_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  batch    ResearchFundScanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  document ResearchFundDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  prompt   ResearchFundPrompt    @relation(fields: [promptId], references: [id])

  @@index([batchId, status])
  @@index([documentId])
  @@index([promptId])
  @@map("research_fund_scan_jobs")
}

// 読み取りプロンプト（議員室ごと・版管理）
model ResearchFundPrompt {
  id           BigInt   @id @default(autoincrement())
  politicianId BigInt   @map("politician_id")
  version      Int
  body         String
  isActive     Boolean  @default(false) @map("is_active")
  updatedById  String?  @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  politician Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  updatedBy  User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  scanJobs ResearchFundScanJob[]

  @@unique([politicianId, version])
  @@index([politicianId, isActive])
  @@map("research_fund_prompts")
}

// 支出群（主要な支出の成果）。金額・件数・期間は items から自動集計する。
model ResearchFundExpenditureGroup {
  id           BigInt   @id @default(autoincrement())
  bookId       BigInt   @map("book_id")
  title        String   @db.VarChar(255)
  description  String // 使った目的と、そこから生まれたもの
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  book ResearchFundBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  items    ResearchFundGroupItem[]
  outcomes ResearchFundGroupOutcome[]

  @@index([bookId])
  @@map("research_fund_expenditure_groups")
}

model ResearchFundGroupItem {
  groupId   BigInt   @map("group_id")
  entryId   BigInt   @unique @map("entry_id") // 1 仕訳は 1 つの支出群にしか属せない
  createdAt DateTime @default(now()) @map("created_at")

  group ResearchFundExpenditureGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entry ResearchFundJournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([groupId, entryId])
  @@map("research_fund_group_items")
}

model ResearchFundGroupOutcome {
  id           BigInt   @id @default(autoincrement())
  groupId      BigInt   @map("group_id")
  label        String   @db.VarChar(255) // "質問主意書（公開）" "議事録" など
  url          String?  @db.VarChar(2048) // NULL なら公開側で「報告は準備中」表示
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  group ResearchFundExpenditureGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("research_fund_group_outcomes")
}

