{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on saturday"],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Prisma packages (exclude v7 due to ESM compatibility issues)",
      "groupName": "prisma",
      "allowedVersions": "<7.0.0",
      "matchPackageNames": [
        "/^prisma$/",
        "/^@prisma//"
      ]
    },
    {
      "description": "Supabase packages",
      "groupName": "supabase",
      "matchPackageNames": [
        "/^@supabase//",
        "/^supabase$/"
      ]
    },
    {
      "description": "Radix UI packages",
      "groupName": "radix-ui",
      "matchPackageNames": [
        "/^@radix-ui//"
      ]
    },
    {
      "description": "TanStack packages",
      "groupName": "tanstack",
      "matchPackageNames": [
        "/^@tanstack//"
      ]
    },
    {
      "description": "AI SDK packages",
      "groupName": "ai-sdk",
      "matchPackageNames": [
        "/^@ai-sdk//",
        "/^ai$/"
      ]
    },
    {
      "description": "Next.js, React and @next/* packages",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@next/**"
      ],
      "groupName": "next-react"
    },
    {
      "description": "Chart libraries",
      "groupName": "charts",
      "matchPackageNames": [
        "/^apexcharts$/",
        "/^react-apexcharts$/",
        "/^@nivo//"
      ]
    },
    {
      "description": "TypeScript type definitions",
      "groupName": "types",
      "matchPackageNames": [
        "/^@types//"
      ]
    },
    {
      "description": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Automerge non-major updates once CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Major updates need dashboard approval (keep PR slots free)",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "devDependencies major updates are automerged once CI passes (no dashboard approval)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["!tailwindcss", "!@tailwindcss/postcss", "!@types/node"],
      "dependencyDashboardApproval": false,
      "automerge": true
    },
    {
      "description": "GitHub Actions updates (including major) are automerged once CI passes",
      "matchManagers": ["github-actions"],
      "dependencyDashboardApproval": false,
      "automerge": true
    },
    {
      "description": "Node.js runtime minor/patch immediate",
      "matchDepNames": ["node"],
      "matchManagers": ["nvm", "nodenv", "dockerfile", "npm", "github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Node.js",
      "groupSlug": "node-runtime",
      "minimumReleaseAge": null,
      "schedule": ["at any time"],
      "prPriority": 10
    },
    {
      "description": "Next.js first in line",
      "matchPackageNames": ["next", "@next/**", "eslint-config-next"],
      "prPriority": 9
    },
    {
      "description": "Next.js / React minor updates need human review (patch is automerged)",
      "matchPackageNames": ["next", "react", "react-dom", "@next/**"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "@supabase/ssr is 0.x and minor updates may break, so they need human review (patch is automerged)",
      "matchPackageNames": ["@supabase/ssr"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Packages that always need human review",
      "matchPackageNames": ["@vercel/queue", "@hyzyla/pdfium"],
      "automerge": false
    }
  ]
}
