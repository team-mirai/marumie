# copy to .env.local for development

# === 必須 ===
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# ローカル supabase の API（supabase/config.toml の [api] port）。デフォルトの 54321 ではないので注意
SUPABASE_URL=http://127.0.0.1:54331
# 値は `pnpm supabase:status --output json` の ANON_KEY / SERVICE_ROLE_KEY
# （seed / E2E は自動取得するので、pnpm dev で admin を動かす場合のみ必要）
SUPABASE_ANON_KEY="your anon key from supabase status"
SUPABASE_SERVICE_ROLE_KEY="your service key from supabase status"

DATA_REFRESH_TOKEN=your-secret-refresh-token
# webapp のキャッシュ無効化リクエスト（DATA_REFRESH_TOKEN を送る）の宛先。
# 本番・ステージングでは https が必須（loopback 以外の http はエラーになる）
WEBAPP_URL=http://localhost:3000
SITE_URL=http://localhost:3001

# === 任意 ===
# 調研費の領収書の保存・表示に使う非公開 Storage バケット名。
# 未設定ならローカルの supabase/config.toml と同名の private-receipts を使う
# RESEARCH_FUND_DOCUMENT_BUCKET=private-receipts
# 議員の顔写真の保存に使う非公開 Storage バケット名。
# 未設定ならローカルの supabase/config.toml と同名の politician-photos を使う
# POLITICIAN_PHOTO_BUCKET=politician-photos
# LLM（取引先・支払先の AI 住所検索、調研費の公開用の版の黒塗り）。APIを使う環境で ANTHROPIC_API_KEY を設定する
# ANTHROPIC_API_KEY=your-anthropic-api-key
# 使うモデルを差し替えるときだけ設定する（未設定時は claude-opus-5-5）
# COUNTERPART_ADDRESS_SEARCH_MODEL=claude-opus-5-5
# 調研費の領収書の読み取り（スキャン・再読み取り）は OpenRouter 経由。APIを使う環境で OPENROUTER_API_KEY を設定する
# OPENROUTER_API_KEY=your-openrouter-api-key
# 読み取りに使うモデルを OpenRouter のモデル ID（<プロバイダ>/<モデル>）で指定する。未設定時は anthropic/claude-opus-5.5
# 例: anthropic/claude-opus-5.5, openai/gpt-6.1-sol
# RESEARCH_FUND_EXTRACTION_MODEL=anthropic/claude-opus-5.5
# 調研費を「公開しない」議員のページのプレビュー URL を作る鍵。webapp と同じ値にする（例: openssl rand -hex 32）。
# 未設定なら議員一覧にプレビュー URL を出せない。値を変えると全議員のプレビュー URL が一斉に変わる
# RESEARCH_FUND_PREVIEW_SECRET=a-long-random-string
# 調研費の書類の公開用の版を作る定期実行（/api/cron/document-masking）の入口の鍵。未設定なら入口は何もしない。
# Vercel では Cron がこの値を Authorization ヘッダーに付けて呼ぶ。ローカルで手動で作るときにも使う（docs/getting-started.md）
# CRON_SECRET=a-long-random-string
# 認証プロバイダー（カンマ区切り。有効値: password, google。未設定時は password のみ）
# ADMIN_AUTH_PROVIDERS=password,google
# Google ログインを許可するメールドメイン（カンマ区切り。未設定時は制限なし）
# AUTH_ALLOWED_EMAIL_DOMAINS=team-mir.ai

# 環境間同期用JSONの取り込み（/sync-import）を有効にする。"true" のときだけ有効（デフォルト拒否）。
# 本番の写しをステージングに戻すための機能なので、ステージングなど非本番環境でのみ true にする。
# VERCEL_ENV=production の環境では、この値によらず常に拒否される
# DATA_SYNC_IMPORT_ENABLED=true
# 同期用JSONをブラウザから直接置く非公開 Storage バケット名（ファイル本体は Vercel の関数を通さない）。
# 未設定ならローカルの supabase/config.toml と同名の sync-imports を使う。上限 200MB 以上のバケットにすること
# DATA_SYNC_IMPORT_BUCKET=sync-imports

# Vercel のカスタム環境名。ステージングでは Vercel が "staging" を入れる。
# ローカルで「[stg]」付きタイトル・STAGING バッジの見た目を確認したいときだけ設定する
# VERCEL_TARGET_ENV=staging

# MAINTENANCE_MODE=true
# MAINTENANCE_MESSAGE=予定時間 22:00-26:00

# ベーシック認証: echo -n "admin:password" | shasum -a 256
# BASIC_AUTH_SECRET=sha256_hash_of_id_password
