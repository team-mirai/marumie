# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"

# Application Configuration
NODE_ENV="development"

# Supabase (seed 用)
# `pnpm db:seed` は起動中のローカル supabase から SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY を
# 自動取得するため設定不要。ローカル以外の supabase に対して seed する場合のみ設定する。
# SUPABASE_URL="http://127.0.0.1:54331"
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
